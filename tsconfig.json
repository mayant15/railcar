{
    "extends": "@tsconfig/node24",
    "compilerOptions": {
        "outDir": "./dist",
        "allowJs": false,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "declaration": true,
        "composite": true,
        "alwaysStrict": true,
        "sourceMap": true,
        "types": ["node", "bun"]
    },
    "references": [
        { "path": "./packages/worker" },
        { "path": "./packages/inference" },
        { "path": "./packages/support" }
    ],
    "exclude": [
        "packages/reporter",
        "benchmarks/projects/**/*",
        "scripts/**/*",
        "dist/**/*"
    ]
}
